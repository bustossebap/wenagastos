<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Bloqueo al abrir: huella o rostro con el diálogo del sistema (el PIN no la necesita). -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!--
        Diagnóstico pregunta por estas apps (¿instalada? ¿habilitada? ¿puede avisar?).
        Desde Android 11 un paquete invisible responde "no existe", así que sin esta lista el
        diagnóstico diría "No instalada" para todas, que es justo el error que debe evitar.
        Se listan los paquetes de `BankSource` uno por uno y no QUERY_ALL_PACKAGES: la app no
        necesita ver nada más del teléfono.
    -->
    <queries>
        <package android:name="cl.santander.smartphone" />
        <package android:name="cl.santander.santanderpasschile" />
        <package android:name="cl.android" />
        <package android:name="com.mercadopago.wallet" />
        <package android:name="com.krealo.tenpo" />
        <package android:name="cl.bancochile.mi_banco" />
        <package android:name="com.google.android.apps.walletnfcrel" />
    </queries>

    <application
        android:name=".WenagastosApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Wenagastos">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Wenagastos">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Lee las notificaciones del banco para registrar los gastos automáticamente.
            Requiere que el usuario active "Acceso a notificaciones" en Ajustes del teléfono.
            La lista `<queries>` de arriba es solo para Diagnóstico: lo que se escucha sigue
            siendo únicamente lo que decida `BankSource`.
        -->
        <service
            android:name=".capture.WenagastosNotificationListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

    </application>

</manifest>
